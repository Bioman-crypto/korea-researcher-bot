DISCORD_TOKEN=여기에_봇_토큰_입력
CONTACT_EMAIL=your@email.com
OPERATOR_ROLE=researcher
ADMIN_ROLE=bot-admin

# 검색 로그용 Google Sheets (선택 — 비워두면 로깅 없이 정상 동작)
# service_account.json 파일 내용을 한 줄로 그대로 붙여넣기 (Railway는 파일 저장이 임시적이라 JSON 내용 자체를 env로 저장)
GOOGLE_SERVICE_ACCOUNT_JSON=
# 검색 로그를 남길 Google Sheets의 ID (시트 URL의 /d/와 /edit 사이 문자열)
GOOGLE_SHEETS_ID=
# 로그를 기록할 시트(탭) 이름. 없으면 자동 생성됨
GOOGLE_SHEETS_WORKSHEET=search_log

# 대프컨 students_master 시트 (읽기 전용, student_id/industry_field 조회용)
# 비워두면 조회 없이 빈 값으로 기록됨
STUDENTS_MASTER_SHEET_ID=
STUDENTS_MASTER_WORKSHEET=students_master
